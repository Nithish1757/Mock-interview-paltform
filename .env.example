# Local API and MongoDB
PORT=5000
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017/prepai


# Required for production sessions; development uses an ephemeral process key when blank
SESSION_SECRET=

# Optional when deploying the frontend and API on separate origins
FRONTEND_ORIGIN=
VITE_API_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:5000
VITE_PORT=5175

# Local Java video-learning pipeline (no Python or cloud AI keys)
JAVA_COMMAND=java
JAVAC_COMMAND=javac
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_KEEP_ALIVE=30m
WHISPER_COMMAND=whisper-cli
WHISPER_MODEL_PATH=./models/ggml-small.bin
FFMPEG_COMMAND=ffmpeg
YT_DLP_COMMAND=yt-dlp
MAX_MEDIA_FILE_MB=1024
