# Local API and MongoDB
PORT=5000
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017/prepai


# Required for production sessions; development uses an ephemeral process key when blank
SESSION_SECRET=

# Optional when deploying the frontend and API on separate origins
FRONTEND_ORIGIN=
VITE_API_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:5000
VITE_PORT=5175
